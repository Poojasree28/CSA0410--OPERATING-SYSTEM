#include <stdio.h>

int mutex = 1;
int full = 0;
int empty = 5;
int x = 0;

void wait(int *s)
{
    (*s)--;
}

void signal(int *s)
{
    (*s)++;
}

int main()
{
    int choice;

    while(1)
    {
        printf("\n1. Produce");
        printf("\n2. Consume");
        printf("\n3. Exit");
        printf("\nEnter your choice: ");
        scanf("%d",&choice);

        switch(choice)
        {
            case 1:
                if(empty!=0)
                {
                    wait(&empty);
                    wait(&mutex);
                    x++;
                    printf("Producer produced item %d\n",x);
                    signal(&mutex);
                    signal(&full);
                }
                else
                {
                    printf("Buffer is Full\n");
                }
                break;

            case 2:
                if(full!=0)
                {
                    wait(&full);
                    wait(&mutex);
                    printf("Consumer consumed item %d\n",x);
                    x--;
                    signal(&mutex);
                    signal(&empty);
                }
                else
                {
                    printf("Buffer is Empty\n");
                }
                break;

            case 3:
                return 0;

            default:
                printf("Invalid Choice\n");
        }
    }
}
