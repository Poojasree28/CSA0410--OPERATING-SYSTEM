#include <stdio.h>

int mutex = 1;
int wrt = 1;
int readcount = 0;

void wait(int *s)
{
    (*s)--;
}

void signal(int *s)
{
    (*s)++;
}

int main()
{
    int choice;

    while (1)
    {
        printf("\n1. Reader");
        printf("\n2. Writer");
        printf("\n3. Exit");
        printf("\nEnter your choice: ");
        scanf("%d", &choice);

        switch (choice)
        {
            case 1:
                wait(&mutex);
                readcount++;

                if (readcount == 1)
                    wait(&wrt);

                signal(&mutex);

                printf("Reader is reading...\n");

                wait(&mutex);
                readcount--;

                if (readcount == 0)
                    signal(&wrt);

                signal(&mutex);
                break;

            case 2:
                wait(&wrt);
                printf("Writer is writing...\n");
                signal(&wrt);
                break;

            case 3:
                return 0;

            default:
                printf("Invalid Choice\n");
        }
    }

    return 0;
}
