#include <stdio.h>

int main()
{
    int block[10], process[10], allocation[10];
    int nb, np;
    int i, j, best;

    printf("Enter number of memory blocks: ");
    scanf("%d", &nb);

    printf("Enter number of processes: ");
    scanf("%d", &np);

    printf("Enter block sizes:\n");
    for(i = 0; i < nb; i++)
        scanf("%d", &block[i]);

    printf("Enter process sizes:\n");
    for(i = 0; i < np; i++)
    {
        scanf("%d", &process[i]);
        allocation[i] = -1;
    }

    // Best Fit Allocation
    for(i = 0; i < np; i++)
    {
        best = -1;

        for(j = 0; j < nb; j++)
        {
            if(block[j] >= process[i])
            {
                if(best == -1 || block[j] < block[best])
                    best = j;
            }
        }

        if(best != -1)
        {
            allocation[i] = best;
            block[best] = block[best] - process[i];
        }
    }

    printf("\nMemory Allocation (Best Fit)\n");
    printf("-------------------------------------------------\n");
    printf("%-10s %-15s %-15s\n", "Process", "Process Size", "Block No.");
    printf("-------------------------------------------------\n");

    for(i = 0; i < np; i++)
    {
        if(allocation[i] != -1)
            printf("P%-9d %-15d %-15d\n", i + 1, process[i], allocation[i] + 1);
        else
            printf("P%-9d %-15d %-15s\n", i + 1, process[i], "Not Allocated");
    }

    return 0;
}
