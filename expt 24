#include <stdio.h>
#include <fcntl.h>
#include <unistd.h>

int main()
{
    int fd;
    char buf[30];

    fd = open("/tmp/sample.txt", O_CREAT | O_RDWR, 0644);

    if(fd == -1)
    {
        perror("open");
        return 1;
    }

    write(fd, "Operating System Lab", 20);

    lseek(fd, 0, SEEK_SET);

    read(fd, buf, 20);
    buf[20] = '\0';

    printf("File Content: %s\n", buf);

    close(fd);

    return 0;
}
