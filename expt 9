#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>
#include <sys/ipc.h>
#include <sys/shm.h>
#include <sys/wait.h>
#include <string.h>

int main()
{
    int shmid;
    key_t key = 1234;
    char *shared_memory;

    // Create shared memory
    shmid = shmget(key, 1024, 0666 | IPC_CREAT);

    if (shmid == -1)
    {
        printf("Shared memory creation failed\n");
        exit(1);
    }

    // Attach shared memory
    shared_memory = (char *)shmat(shmid, NULL, 0);

    if (shared_memory == (char *)-1)
    {
        printf("Attachment failed\n");
        exit(1);
    }

    if (fork() == 0)
    {
        // Child process
        sleep(2);

        printf("\nChild Process\n");
        printf("Received Data: %s\n", shared_memory);

        shmdt(shared_memory);
    }
    else
    {
        // Parent process
        printf("Parent Process\n");

        strcpy(shared_memory, "Hello from Parent through Shared Memory");

        printf("Data written successfully\n");

        wait(NULL);

        shmdt(shared_memory);

        // Remove shared memory
        shmctl(shmid, IPC_RMID, NULL);
    }

    return 0;
}
